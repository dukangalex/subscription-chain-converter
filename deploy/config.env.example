# Copy to config.env and edit. Every value has the default shown here.

# Public hostname the converter will be served on. All generated rule
# URLs point at https://<DOMAIN>/rules/... — use a domain you control.
DOMAIN=sub.example.com

# Where the application lives on the server.
INSTALL_DIR=/opt/subconv

# Loopback ports (the services never bind publicly; exposure happens
# only through your tunnel / reverse proxy).
PAGE_PORT=18081
CONV_PORT=18080

# Pinned component versions.
SUBCONVERTER_VERSION=v0.9.0
NODE_VERSION=v22.14.0

# Set to 1 to lay files down and self-test without systemd
# (containers / CI / evaluation). Services are not registered then.
NO_SYSTEMD=0
