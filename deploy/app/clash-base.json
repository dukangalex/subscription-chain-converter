  "AND,((NETWORK,UDP),(DST-PORT,3478-3497)),REJECT",
  "AND,((NETWORK,UDP),(DST-PORT,5349)),REJECT",
  "AND,((NETWORK,UDP),(DST-PORT,19302-19309)),REJECT",
  "AND,((NETWORK,TCP),(DST-PORT,3478-3497)),REJECT",
